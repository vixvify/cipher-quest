<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cipherquest.ui.MainMenuController"
           styleClass="main-root">

    <Region styleClass="background-layer" />

    <Canvas fx:id="matrixCanvas" />

    <Region styleClass="vignette-overlay" mouseTransparent="true" />

    <BorderPane fx:id="hudContainer" styleClass="hud-container">

        <top>
            <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="15">
                <padding>
                    <Insets top="18" right="30" bottom="10" left="30" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="status-pill">
                    <Region styleClass="status-dot" />
                    <Label text="TERMINAL ONLINE // CQ-OS v2.5" styleClass="status-text" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="tickerLabel" text="[ ENCRYPTION ENGINE: ACTIVE | AES-256 ]" styleClass="ticker-text" />

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="soundButton" text="🔊 AUDIO: ON" onAction="#onToggleSound" styleClass="header-button" />
                    <Button fx:id="fullscreenButton" text="⛶ FULLSCREEN" onAction="#onToggleFullscreen" styleClass="header-button" />
                </HBox>
            </HBox>
        </top>

        <center>
            <VBox alignment="CENTER">
                <VBox alignment="CENTER" spacing="18" styleClass="cyber-card" maxWidth="600">
                    <padding>
                        <Insets top="35" right="45" bottom="30" left="45" />
                    </padding>

                    <Label text="CLASSIFIED CRYPTOGRAPHY TERMINAL" styleClass="card-sub-header" />

                    <VBox alignment="CENTER" spacing="8">
                        <HBox alignment="CENTER" spacing="0">
                            <Label text="CIPHER" styleClass="logo-cyan" />
                            <Label text="QUEST" styleClass="logo-green" />
                        </HBox>
                        <Label fx:id="subtitleLabel" text="[ DECRYPT THE PAST • ENCODE THE FUTURE ]" styleClass="subtitle-text" />
                    </VBox>

                    <Separator styleClass="cyber-separator" />

                    <VBox alignment="CENTER" spacing="12" styleClass="menu-buttons-box">
                        <Button text="▶   START MISSION" onAction="#onStartGame" styleClass="menu-btn, menu-btn-primary" maxWidth="400" />
                        <Button text="⚡   SELECT LEVEL" onAction="#onLevelSelect" styleClass="menu-btn" maxWidth="400" />
                        <Button text="🔐   CIPHER LAB &amp; HOW TO PLAY" onAction="#onHowToPlay" styleClass="menu-btn" maxWidth="400" />
                        <Button text="⚙   SYSTEM SETTINGS" onAction="#onSettings" styleClass="menu-btn" maxWidth="400" />
                        <Button text="✕   DISCONNECT (EXIT)" onAction="#onExit" styleClass="menu-btn, menu-btn-danger" maxWidth="400" />
                    </VBox>

                    <HBox alignment="CENTER" spacing="6" styleClass="terminal-prompt-box">
                        <Label text="agent@cipherquest:~$" styleClass="terminal-user" />
                        <Label fx:id="cursorLabel" text="awaiting_input_" styleClass="terminal-cmd" />
                    </HBox>

                </VBox>
            </VBox>
        </center>

        <bottom>
            <HBox styleClass="bottom-bar" alignment="CENTER" spacing="20">
                <padding>
                    <Insets top="10" right="30" bottom="15" left="30" />
                </padding>
                <Label text="[ OOP FINAL PROJECT ]" styleClass="footer-dim" />
                <Label text="•" styleClass="footer-dot" />
                <Label text="CIPHERQUEST v1.0.0" styleClass="footer-bright" />
                <Label text="•" styleClass="footer-dot" />
                <Label text="HOTKEYS: [ESC] RETURN | [ENTER] EXECUTE" styleClass="footer-dim" />
            </HBox>
        </bottom>

    </BorderPane>

    <StackPane fx:id="modalOverlay" styleClass="modal-backdrop" visible="false">

        <VBox fx:id="cipherLabModal" styleClass="modal-box" maxWidth="750" spacing="16" visible="false">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🔐 CIPHER LAB &amp; FIELD MANUAL" styleClass="modal-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="✕" onAction="#onCloseOverlay" styleClass="modal-close-btn" />
            </HBox>

            <Separator styleClass="cyber-separator" />

            <TabPane styleClass="cyber-tabs" tabClosingPolicy="UNAVAILABLE">
                <Tab text="📖 HOW TO PLAY">
                    <VBox spacing="14" styleClass="tab-content">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15" />
                        </padding>
                        <Label text="MISSION BRIEFING:" styleClass="brief-title" />
                        <Label text="ยินดีต้อนรับสู่ CipherQuest! ภารกิจของคุณคือการเจาะระบบความปลอดภัยและถอดรหัสลับ (Decryption) ในแต่ละสถานการณ์ โดยใช้ความรู้ด้านวิทยาการรหัสลับ (Cryptography) เช่น Caesar Cipher, Atbash, Vigenère และ RSA เพื่อปลดล็อกข้อมูลสำคัญของระบบ!"
                               wrapText="true" styleClass="brief-body" />

                        <VBox spacing="6">
                            <Label text="🎯 กฎและวิธีการเล่น:" styleClass="brief-subtitle" />
                            <Label text="1. อ่านคำใบ้ (Hint) และข้อความที่ถูกเข้ารหัส (Ciphertext) ประจำด่าน" styleClass="brief-body" />
                            <Label text="2. วิเคราะห์อัลกอริทึมการเข้ารหัส แล้วคำนวณถอดรหัสข้อความ" styleClass="brief-body" />
                            <Label text="3. ส่งรหัสคำตอบที่ถูกต้องเพื่อปลดล็อกด่านถัดไปและสะสมแต้มคะแนน" styleClass="brief-body" />
                        </VBox>
                    </VBox>
                </Tab>

                <Tab text="🧪 LIVE CIPHER LAB">
                    <VBox spacing="14" styleClass="tab-content">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15" />
                        </padding>
                        <Label text="ทดลองจำลองการเข้ารหัส Caesar Cipher แบบเรียลไทม์:" styleClass="brief-subtitle" />

                        <VBox spacing="5">
                            <Label text="ข้อความต้นฉบับ (Plaintext):" styleClass="input-label" />
                            <TextField fx:id="labInputField" text="HELLO CIPHERQUEST" promptText="พิมพ์ข้อความที่ต้องการทดสอบ..." styleClass="cyber-input" onKeyReleased="#onCipherTestInput" />
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label text="จำนวนก้าว (Shift):" styleClass="input-label" />
                            <Slider fx:id="labShiftSlider" min="1" max="25" value="3" blockIncrement="1" showTickMarks="true" showTickLabels="true" majorTickUnit="5" HBox.hgrow="ALWAYS" />
                            <Label fx:id="labShiftValue" text="Shift: 3" styleClass="slider-value" />
                        </HBox>

                        <VBox spacing="5">
                            <Label text="ผลลัพธ์การเข้ารหัส (Ciphertext):" styleClass="input-label" />
                            <TextField fx:id="labOutputField" editable="false" styleClass="cyber-input, cyber-input-output" />
                        </VBox>
                    </VBox>
                </Tab>
            </TabPane>

            <HBox alignment="CENTER_RIGHT">
                <Button text="[ CLOSE TERMINAL ]" onAction="#onCloseOverlay" styleClass="menu-btn" />
            </HBox>
        </VBox>

        <VBox fx:id="levelSelectModal" styleClass="modal-box" maxWidth="750" spacing="16" visible="false">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="⚡ SELECT MISSION LEVEL" styleClass="modal-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="✕" onAction="#onCloseOverlay" styleClass="modal-close-btn" />
            </HBox>

            <Separator styleClass="cyber-separator" />

            <GridPane hgap="15" vgap="15" alignment="CENTER">
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="level-card, level-active" spacing="6" onMouseClicked="#onSelectLevel1">
                    <padding>
                        <Insets top="14" right="16" bottom="14" left="16" />
                    </padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="MISSION 01" styleClass="level-num" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="● READY" styleClass="level-badge-ready" />
                    </HBox>
                    <Label text="Caesar's Secret" styleClass="level-name" />
                    <Label text="Shift cipher basics • Ancient Rome cryptography" wrapText="true" styleClass="level-desc" />
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="level-card, level-locked" spacing="6">
                    <padding>
                        <Insets top="14" right="16" bottom="14" left="16" />
                    </padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="MISSION 02" styleClass="level-num" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="🔒 LOCKED" styleClass="level-badge-locked" />
                    </HBox>
                    <Label text="Atbash Inversion" styleClass="level-name" />
                    <Label text="Hebrew reverse cipher • Symmetric substitution" wrapText="true" styleClass="level-desc" />
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="level-card, level-locked" spacing="6">
                    <padding>
                        <Insets top="14" right="16" bottom="14" left="16" />
                    </padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="MISSION 03" styleClass="level-num" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="🔒 LOCKED" styleClass="level-badge-locked" />
                    </HBox>
                    <Label text="Vigenère Enigma" styleClass="level-name" />
                    <Label text="Polyalphabetic encryption • Tabula recta" wrapText="true" styleClass="level-desc" />
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="level-card, level-locked" spacing="6">
                    <padding>
                        <Insets top="14" right="16" bottom="14" left="16" />
                    </padding>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="MISSION 04" styleClass="level-num" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="🔒 LOCKED" styleClass="level-badge-locked" />
                    </HBox>
                    <Label text="The RSA Master Key" styleClass="level-name" />
                    <Label text="Asymmetric cryptography • Public/Private keys" wrapText="true" styleClass="level-desc" />
                </VBox>
            </GridPane>

            <HBox alignment="CENTER_RIGHT">
                <Button text="[ BACK ]" onAction="#onCloseOverlay" styleClass="menu-btn" />
            </HBox>
        </VBox>

        <VBox fx:id="settingsModal" styleClass="modal-box" maxWidth="600" spacing="16" visible="false">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="⚙ SYSTEM SETTINGS" styleClass="modal-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="✕" onAction="#onCloseOverlay" styleClass="modal-close-btn" />
            </HBox>

            <Separator styleClass="cyber-separator" />

            <VBox spacing="16" styleClass="settings-box">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🔊 Master Volume:" styleClass="setting-label" minWidth="150" />
                    <Slider fx:id="masterVolumeSlider" min="0" max="100" value="80" HBox.hgrow="ALWAYS" />
                    <Label fx:id="masterVolumeLabel" text="80%" styleClass="slider-value" minWidth="45" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🎵 Music / Ambience:" styleClass="setting-label" minWidth="150" />
                    <Slider fx:id="musicVolumeSlider" min="0" max="100" value="70" HBox.hgrow="ALWAYS" />
                    <Label fx:id="musicVolumeLabel" text="70%" styleClass="slider-value" minWidth="45" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="👾 SFX Sound Effects:" styleClass="setting-label" minWidth="150" />
                    <Slider fx:id="sfxVolumeSlider" min="0" max="100" value="90" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sfxVolumeLabel" text="90%" styleClass="slider-value" minWidth="45" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="⚡ Visual Matrix Stream:" styleClass="setting-label" minWidth="150" />
                    <CheckBox fx:id="matrixRainToggle" text="Enabled" selected="true" styleClass="cyber-checkbox" onAction="#onToggleMatrixRain" />
                </HBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <Button text="[ APPLY &amp; CLOSE ]" onAction="#onCloseOverlay" styleClass="menu-btn, menu-btn-primary" />
            </HBox>
        </VBox>

    </StackPane>

</StackPane>
