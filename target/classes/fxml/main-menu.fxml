<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cipherquest.ui.MainMenuController"
           styleClass="main-root">

    <Region styleClass="background-layer" />
    <Canvas fx:id="matrixCanvas" />
    <Region styleClass="vignette-overlay" mouseTransparent="true" />

    <VBox alignment="CENTER" spacing="40">
        <VBox alignment="CENTER" spacing="10">
            <HBox alignment="CENTER" spacing="0">
                <Label text="CIPHER" styleClass="logo-cyan" />
                <Label text="QUEST" styleClass="logo-green" />
            </HBox>
            <Label text="decrypt the past  •  encode the future" styleClass="subtitle-text" />
        </VBox>

        <Button text="▶  START GAME" onAction="#onStartGame" styleClass="start-btn" />
    </VBox>

</StackPane>
