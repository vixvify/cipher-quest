<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cipherquest.ui.MainMenuController" styleClass="main-root">
    <Region styleClass="hero-art" />
    <Canvas fx:id="rainCanvas" managed="false" mouseTransparent="true" />
    <Region styleClass="hero-shade" mouseTransparent="true" />

    <HBox alignment="CENTER_RIGHT" fillHeight="false" pickOnBounds="false" styleClass="hero-layout">
        <VBox fx:id="heroCopy" alignment="CENTER_LEFT" spacing="24" minWidth="0" maxWidth="580" styleClass="hero-copy">
            <VBox spacing="4" accessibleText="CipherQuest">
                <Text text="CIPHER" boundsType="VISUAL" styleClass="hero-title" />
                <Text text="QUEST" boundsType="VISUAL" styleClass="hero-title, hero-title-accent" />
            </VBox>
            <Label text="แกะรอยข้อความลับ ฝ่าเทอร์มินัล และค้นหาความทรงจำที่หายไปในคลังข้อมูลโบราณ"
                   wrapText="true" maxWidth="365" styleClass="hero-description" />
            <Button text="เริ่มภารกิจ  →" onAction="#onStartGame" defaultButton="true" styleClass="hero-button" />
        </VBox>
    </HBox>
</StackPane>
