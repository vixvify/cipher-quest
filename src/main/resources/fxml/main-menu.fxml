<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cipherquest.ui.menu.MainMenuController" styleClass="main-root">
    <Region fx:id="heroArtwork" styleClass="hero-art" scaleX="1.025" scaleY="1.025" />
    <Region fx:id="gateLight" styleClass="hero-gate-light" mouseTransparent="true" />
    <Canvas fx:id="rainCanvas" managed="false" mouseTransparent="true" />
    <Region styleClass="hero-shade" mouseTransparent="true" />
    <Button fx:id="soundButton" onAction="#onToggleSound" styleClass="hero-sound" StackPane.alignment="TOP_RIGHT" />

    <HBox alignment="CENTER_RIGHT" fillHeight="false" pickOnBounds="false" styleClass="hero-layout">
        <VBox fx:id="heroCopy" alignment="CENTER_LEFT" spacing="16" minWidth="0" maxWidth="580" styleClass="hero-copy">
            <VBox spacing="4" accessibleText="CipherQuest">
                <Text text="CIPHER" boundsType="VISUAL" styleClass="hero-title" />
                <Text text="QUEST" boundsType="VISUAL" styleClass="hero-title, hero-title-accent" />
            </VBox>
            <StackPane alignment="CENTER_LEFT" minHeight="3" prefHeight="3" maxHeight="3" maxWidth="220"
                       mouseTransparent="true" styleClass="hero-signal-track">
                <Region fx:id="signalSweep" minHeight="3" maxHeight="3" prefWidth="54" maxWidth="54"
                        styleClass="hero-signal-sweep" />
            </StackPane>
            <VBox spacing="14" maxWidth="418" styleClass="hero-actions">
                <Label text="ประตูคลังถูกปิดตาย ตามรอยหลักฐานเพื่อเปิดระบบขึ้นมาอีกครั้ง"
                       wrapText="true" styleClass="hero-description" />
                <HBox spacing="9" alignment="CENTER_LEFT">
                    <Button text="เข้าสู่โถง  →" onAction="#onStartGame" defaultButton="true" styleClass="hero-button" />
                    <Button fx:id="controlsButton" text="วิธีเล่น" onAction="#onShowControls" styleClass="hero-secondary" />
                </HBox>
                <HBox spacing="7" alignment="CENTER_LEFT">
                    <Label text="WASD" styleClass="hero-key" />
                    <Label text="เดิน" styleClass="hero-key-caption" />
                    <Label text="E" styleClass="hero-key" />
                    <Label text="สำรวจ" styleClass="hero-key-caption" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
