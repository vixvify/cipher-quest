<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="missionRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cipherquest.ui.SqlWorkbenchController" styleClass="mission-root, sql-root">
    <VBox spacing="16" maxWidth="1380" styleClass="mission-shell">
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="mission-bar">
            <Region styleClass="signal-mark" />
            <Label text="CIPHERQUEST  /  SQL WORKBENCH" styleClass="mission-channel" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="knowledgeButton" text="ความรู้ SQL" onAction="#onOpenKnowledge" styleClass="support-button" />
            <Button fx:id="cluesButton" text="เบาะแส" onAction="#onOpenClues" styleClass="support-button" />
            <Button fx:id="hintButton" text="คำใบ้" onAction="#onOpenHints" styleClass="support-button" />
            <Label fx:id="checkpointLabel" styleClass="checkpoint-tag" />
        </HBox>
        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <VBox spacing="12" minWidth="150" prefWidth="185" styleClass="schema-panel">
                <Label text="DATABASE" styleClass="eyebrow" />
                <Label text="ancient_archive" styleClass="panel-title" />
                <Separator />
                <Label text="Tables" styleClass="schema-caption" />
                <VBox fx:id="schemaTables" spacing="5" />
            </VBox>
            <VBox spacing="10" minWidth="0" HBox.hgrow="ALWAYS">
                <VBox spacing="6" styleClass="sql-mission-panel">
                    <Label fx:id="missionTitle" styleClass="sql-mission-title" wrapText="true" />
                    <Label fx:id="taskLabel" styleClass="mission-description" wrapText="true" minHeight="-Infinity" />
                </VBox>
                <SplitPane orientation="VERTICAL" dividerPositions="0.48" VBox.vgrow="ALWAYS" styleClass="sql-split">
                    <VBox minHeight="100" styleClass="sql-panel">
                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="sql-panel-header">
                            <Label text="query.sql" styleClass="panel-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="clearButton" text="Clear" onAction="#onClearQuery" styleClass="secondary-button" />
                            <Button fx:id="runButton" text="Run Query  →" onAction="#onRunQuery" styleClass="primary-button" />
                        </HBox>
                        <TextArea fx:id="queryArea" accessibleText="SQL query" promptText="-- Write SQL here"
                                  styleClass="sql-editor" VBox.vgrow="ALWAYS" minHeight="50" />
                    </VBox>
                    <VBox minHeight="100" styleClass="sql-panel">
                        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="sql-panel-header">
                            <Label text="Results" styleClass="panel-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="rowCountLabel" text="0 rows" styleClass="schema-caption" />
                            <Label fx:id="resultStatusLabel" text="Ready" styleClass="schema-caption" />
                        </HBox>
                        <TableView fx:id="resultTable" VBox.vgrow="ALWAYS" minHeight="45" styleClass="sql-result-table">
                            <placeholder><Label text="ผลการค้นหาจะแสดงที่นี่" styleClass="schema-caption" /></placeholder>
                        </TableView>
                    </VBox>
                </SplitPane>
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sql-footer">
                    <Label fx:id="feedbackLabel" wrapText="true" minWidth="0" maxWidth="Infinity" minHeight="-Infinity"
                           HBox.hgrow="ALWAYS" styleClass="sql-feedback" />
                    <Label fx:id="statusLabel" text="●  CONNECTED" styleClass="terminal-status" />
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</StackPane>
