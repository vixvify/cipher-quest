<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cipherquest.ui.TerminalScreenController"
           styleClass="terminal-root">

    <Region styleClass="desk-surface" />

    <VBox alignment="CENTER" spacing="0">

        <StackPane styleClass="monitor-frame">

            <VBox styleClass="monitor-bezel" alignment="CENTER" spacing="0">

                <HBox styleClass="monitor-screen-top-bar" prefHeight="28" alignment="CENTER_LEFT" spacing="8">
                    <padding>
                        <Insets left="14" />
                    </padding>
                    <Region styleClass="dot-red" />
                    <Region styleClass="dot-yellow" />
                    <Region styleClass="dot-green" />
                    <Label text="agent@cipherquest: ~ — bash" styleClass="screen-title-bar" HBox.hgrow="ALWAYS" />
                </HBox>

                <VBox styleClass="terminal-screen-body" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="14" right="16" bottom="14" left="16" />
                    </padding>

                    <ScrollPane fx:id="outputScrollPane" styleClass="terminal-scroll" VBox.vgrow="ALWAYS"
                                fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                        <VBox fx:id="outputBox" styleClass="terminal-output-box" spacing="2">
                            <Label text="CipherQuest OS — Linux Terminal Emulator v5.15" styleClass="term-system-msg" />
                            <Label text="Type your command and press [ENTER] to execute." styleClass="term-system-msg" />
                            <Label text="" />
                            <Label text="agent@cipherquest:~$ " styleClass="term-prompt" />
                        </VBox>
                    </ScrollPane>

                    <Region prefHeight="8" />

                    <HBox styleClass="terminal-input-row" spacing="0" alignment="CENTER_LEFT">
                        <Label fx:id="promptLabel" text="agent@cipherquest:~$" styleClass="term-input-prompt" />
                        <TextField fx:id="commandField"
                                   promptText="type command here..."
                                   styleClass="term-input-field"
                                   HBox.hgrow="ALWAYS"
                                   onAction="#onExecuteCommand" />
                        <Button text="EXEC" onAction="#onExecuteCommand" styleClass="term-exec-btn" />
                    </HBox>

                </VBox>

                <HBox styleClass="monitor-screen-bottom-bar" prefHeight="22" alignment="CENTER_RIGHT" spacing="16">
                    <padding>
                        <Insets right="14" />
                    </padding>
                    <Label text="CHECKPOINT 2 / 7" styleClass="screen-status-text" />
                    <Label fx:id="statusLabel" text="●  AWAITING COMMAND" styleClass="screen-status-warn" />
                </HBox>

            </VBox>

        </StackPane>

        <Region styleClass="monitor-chin" prefHeight="22" />

    </VBox>

</StackPane>
