<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="missionRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cipherquest.ui.mission.TerminalScreenController" styleClass="mission-root, workstation-root, terminal-root">
    <VBox spacing="16" maxWidth="1380" styleClass="mission-shell">
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="mission-bar">
            <Region styleClass="signal-mark" />
            <Label text="CIPHERQUEST  /  TERMINAL" styleClass="mission-channel" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="backToArchiveButton" text="สำรวจ" accessibleText="กลับโถงสำรวจ"
                    onAction="#onReturnToArchive" styleClass="support-button" />
            <Button fx:id="fieldNotesButton" text="หลักฐาน" onAction="#onOpenFieldNotes" styleClass="support-button" />
            <Button fx:id="hintButton" text="คำใบ้" onAction="#onOpenHints" styleClass="support-button" />
            <Label fx:id="checkpointLabel" styleClass="checkpoint-tag" />
        </HBox>
        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <VBox spacing="13" minWidth="195" prefWidth="243" styleClass="brief-panel, terminal-brief">
                <Label text="MISSION BRIEF" styleClass="eyebrow" />
                <Label fx:id="missionTitle" wrapText="true" styleClass="mission-title" />
                <Label fx:id="missionLabel" wrapText="true" minHeight="-Infinity" styleClass="mission-description" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" minWidth="0" styleClass="terminal-panel">
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="terminal-header">
                    <Label text="~/ ❯" styleClass="terminal-icon" />
                    <Label text="Bash" styleClass="panel-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <ProgressIndicator fx:id="commandActivity" styleClass="terminal-activity"
                                       visible="false" managed="false" accessibleText="กำลังรันคำสั่ง" />
                    <Label fx:id="statusLabel" text="READY" styleClass="terminal-status" />
                </HBox>
                <ScrollPane fx:id="outputScrollPane" VBox.vgrow="ALWAYS" fitToWidth="true"
                            hbarPolicy="NEVER" styleClass="terminal-scroll">
                    <VBox fx:id="outputBox" spacing="8" styleClass="terminal-output-box" />
                </ScrollPane>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="terminal-input-row">
                    <Label fx:id="promptLabel" maxWidth="132" styleClass="term-input-prompt" />
                    <TextField fx:id="commandField" accessibleText="Bash command" promptText="Enter command"
                               HBox.hgrow="ALWAYS" minWidth="0" onAction="#onExecuteCommand" styleClass="term-input-field" />
                    <Button fx:id="executeButton" text="Run" minWidth="-Infinity"
                            onAction="#onExecuteCommand" styleClass="primary-button" />
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</StackPane>
