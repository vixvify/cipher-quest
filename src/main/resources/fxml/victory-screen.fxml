<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cipherquest.ui.VictoryScreenController"
           styleClass="mission-root, victory-root">
    <Region maxWidth="680" maxHeight="520" mouseTransparent="true" styleClass="victory-signal" />
    <VBox alignment="CENTER" spacing="18" maxWidth="560" maxHeight="-Infinity" styleClass="victory-card">
        <Label text="กู้คืนคลังข้อมูลสำเร็จ" wrapText="true" textAlignment="CENTER"
               styleClass="mission-title, victory-title" />

        <VBox alignment="CENTER" styleClass="victory-score">
            <Label fx:id="scoreLabel" text="0" styleClass="victory-score-value" />
            <Label text="คะแนนรวม" styleClass="victory-score-caption" />
        </VBox>

        <HBox alignment="CENTER" spacing="25" styleClass="victory-stats">
            <VBox alignment="CENTER" spacing="3" styleClass="victory-stat">
                <Label fx:id="checkpointsLabel" styleClass="victory-stat-value" />
                <Label text="ด่านที่ผ่าน" styleClass="victory-stat-caption" />
            </VBox>
            <Separator orientation="VERTICAL" />
            <VBox alignment="CENTER" spacing="3" styleClass="victory-stat">
                <Label fx:id="cluesFoundLabel" styleClass="victory-stat-value" />
                <Label text="หลักฐานที่เก็บ" styleClass="victory-stat-caption" />
            </VBox>
        </HBox>

        <TitledPane fx:id="endingPanel" text="บทส่งท้าย" expanded="false" animated="false"
                    maxWidth="430" styleClass="victory-epilogue">
            <content>
                <Label fx:id="endingDescription" wrapText="true" minHeight="-Infinity"
                       styleClass="victory-epilogue-copy" />
            </content>
        </TitledPane>

        <Button text="กลับหน้าหลัก" onAction="#onReturnToMainMenu" styleClass="primary-button, victory-button" />
    </VBox>
</StackPane>
