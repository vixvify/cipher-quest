<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="missionRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cipherquest.ui.PasskeyScreenController" styleClass="mission-root, passkey-root">
    <Region mouseTransparent="true" styleClass="passkey-ambient-art" />
    <VBox spacing="20" maxWidth="1090" maxHeight="-Infinity" styleClass="mission-shell">
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="mission-bar">
            <Region styleClass="signal-mark" />
            <Label text="CIPHERQUEST  /  DECRYPTION" styleClass="mission-channel" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="hintButton" text="คำใบ้" onAction="#onOpenHints" styleClass="support-button" />
            <Label fx:id="checkpointLabel" styleClass="checkpoint-tag" />
        </HBox>

        <HBox spacing="20" styleClass="passkey-layout">
            <VBox spacing="15" minWidth="0" prefWidth="505" HBox.hgrow="ALWAYS" styleClass="brief-panel">
                <Label text="MISSION BRIEF" styleClass="eyebrow" />
                <Label fx:id="missionTitle" wrapText="true" styleClass="mission-title" />
                <Label fx:id="missionLabel" wrapText="true" styleClass="mission-description" />
                <StackPane alignment="CENTER_LEFT" styleClass="evidence-mount">
                    <Button fx:id="evidenceButton" onAction="#onFlipEvidence" styleClass="evidence-card"
                            accessibleText="พลิกบัตรหลักฐาน" contentDisplay="GRAPHIC_ONLY">
                        <graphic>
                            <VBox spacing="4" mouseTransparent="true">
                                <Label fx:id="evidenceCaption" text="INTERCEPTED" styleClass="evidence-caption" />
                                <Label fx:id="evidenceText" text="พลิกดูด้านหลัง  ↻" styleClass="evidence-text" />
                            </VBox>
                        </graphic>
                    </Button>
                    <Region mouseTransparent="true" maxWidth="55" maxHeight="14" translateX="61" translateY="-5"
                            StackPane.alignment="TOP_LEFT" styleClass="evidence-tape" />
                </StackPane>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="13" minWidth="0" prefWidth="440" HBox.hgrow="ALWAYS" styleClass="passkey-panel">
                <Label text="WORKSTATION ACCESS" styleClass="eyebrow" />
                <Label text="ปลดล็อกเครื่อง" styleClass="mission-title" />
                <Label text="รหัสผ่านที่ถอดได้" styleClass="panel-title" />
                <PasswordField fx:id="passkeyField" promptText="กรอก Passkey" accessibleText="รหัสผ่านที่ถอดได้"
                               styleClass="text-entry" onAction="#onSubmitPasskey" />
                <Button fx:id="authenticateButton" text="ยืนยันรหัส  →" onAction="#onSubmitPasskey"
                        styleClass="primary-button" maxWidth="Infinity" />
                <Label fx:id="feedbackLabel" wrapText="true" styleClass="passkey-feedback" />
            </VBox>
        </HBox>
    </VBox>
</StackPane>
