<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cipherquest.ui.PasskeyScreenController"
           styleClass="passkey-root">

    <Region styleClass="desk-surface" />

    <VBox alignment="CENTER" spacing="0">
        <Region styleClass="monitor-stand-neck" prefWidth="12" prefHeight="40" />
        <Region styleClass="monitor-stand-base" prefWidth="120" prefHeight="14" />
    </VBox>

    <VBox alignment="CENTER" spacing="0">

        <StackPane styleClass="monitor-frame">

            <VBox styleClass="monitor-bezel" alignment="CENTER" spacing="0">

                <HBox styleClass="monitor-screen-top-bar" prefHeight="28" alignment="CENTER_LEFT" spacing="8">
                    <padding>
                        <Insets left="14" />
                    </padding>
                    <Region styleClass="dot-red" />
                    <Region styleClass="dot-yellow" />
                    <Region styleClass="dot-green" />
                    <Label text="CQ-OS — SECURE TERMINAL v2.5" styleClass="screen-title-bar" HBox.hgrow="ALWAYS" />
                </HBox>

                <VBox styleClass="screen-body" alignment="CENTER" spacing="24" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="40" right="50" bottom="40" left="50" />
                    </padding>

                    <VBox alignment="CENTER" spacing="6">
                        <Label text="⬛⬛⬛" styleClass="screen-lock-icon" />
                        <Label text="SYSTEM LOCKED" styleClass="screen-locked-title" />
                        <Label text="Authentication required to access this workstation" styleClass="screen-locked-sub" />
                    </VBox>

                    <Region prefHeight="10" />

                    <VBox alignment="CENTER" spacing="10" styleClass="passkey-form">
                        <Label text="ENTER PASSKEY:" styleClass="passkey-label" />

                        <HBox alignment="CENTER" spacing="0" styleClass="passkey-input-box">
                            <PasswordField fx:id="passkeyField"
                                          promptText="_ _ _ _ _ _ _ _ _ _"
                                          styleClass="passkey-field"
                                          HBox.hgrow="ALWAYS"
                                          onAction="#onSubmitPasskey" />
                        </HBox>

                        <Label fx:id="feedbackLabel" text="" styleClass="passkey-feedback" />

                        <Button text="[ AUTHENTICATE ]" onAction="#onSubmitPasskey" styleClass="auth-btn" />
                    </VBox>

                    <Region prefHeight="10" />

                    <HBox alignment="CENTER" spacing="6">
                        <Label text="HINT:" styleClass="hint-label" />
                        <Label fx:id="hintLabel" text="ถอดรหัส Ciphertext ด้านบนเพื่อหา Passkey" styleClass="hint-text" wrapText="true" />
                    </HBox>

                    <VBox styleClass="ciphertext-box" alignment="CENTER" spacing="6">
                        <Label text="INTERCEPTED MESSAGE:" styleClass="cipher-box-title" />
                        <Label fx:id="ciphertextLabel" text="FLSKHUTZXHVW" styleClass="ciphertext-display" />
                    </VBox>
                </VBox>

                <HBox styleClass="monitor-screen-bottom-bar" prefHeight="22" alignment="CENTER_RIGHT" spacing="16">
                    <padding>
                        <Insets right="14" />
                    </padding>
                    <Label text="CHECKPOINT 1 / 7" styleClass="screen-status-text" />
                    <Label text="●  LOCKED" styleClass="screen-status-locked" />
                </HBox>

            </VBox>

        </StackPane>

        <Region styleClass="monitor-chin" prefHeight="22" />

    </VBox>

</StackPane>
